# 复制为 .env（或 .env.local）后填写，两行就够用
# 网关地址：你的 wx-draft-worker 部署地址（去末尾斜杠）
WX_GATEWAY_URL=https://wx-draft-worker.your-subdomain.workers.dev

# 业务令牌：在网关后台「令牌管理」创建，形如 wxk_xxxxxxxx
WX_GATEWAY_TOKEN=wxk_xxxxxxxxxxxxxxxxxxxxxxxx

# ——— 以下都是可选项 ———
# 默认作者（微信限制 ≤ 8 字）
# WX_GATEWAY_AUTHOR=百晓文苑
# 默认排版主题（18 套，见 `wewrite-push themes`）
# WX_GATEWAY_THEME=professional-clean
# 默认公众号（多账号时用，值为后台「公众号管理」里的账号 id）
# WX_GATEWAY_ACCOUNT_ID=
# 本地代理（需要时填写，例如科学上网环境）
# WX_GATEWAY_PROXY=http://127.0.0.1:10808
# 单次请求超时（秒）
# WX_GATEWAY_TIMEOUT=180
